# ---- EnableX Voice API credentials (from your EnableX project) ----
# Get these from https://portal.enablex.io -> your Voice project.
ENABLEX_APP_ID=
ENABLEX_APP_KEY=

# A phone number provisioned in your EnableX project (the caller ID).
# Must be a number you own/provisioned in EnableX, e.g. +91XXXXXXXXXX
ENABLEX_FROM_NUMBER=

# Public HTTPS URL that EnableX can reach to deliver call events (webhooks).
# Required for the multi-question IVR flow. For local testing use ngrok:
#   ngrok http 3000   -> then set this to the https URL it gives you.
# Leave blank to run in single-prompt mode (only the intro plays).
PUBLIC_WEBHOOK_URL=

# ---- Optional ----
PORT=3000
# TTS_LANGUAGE=en-US
# TTS_VOICE=female
# ENABLEX_BASE_URL=https://api.enablex.io

# ---- Demo portal integration (additive) ----
# Demo portal origin. Used so that logging out of this app also ends the demo
# portal session, and — for sessions launched from the portal — returns the user
# to the portal login page. If unset, logout falls back to this app's own login.
PORTAL_URL=https://portal.example.com

# ---- Gemini API (AI Summary + Structured Answers) ----
# Google Gemini API key. If unset, AI features are a safe no-op.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ---- MongoDB (stores call transcripts + all analysis) ----
# Atlas/company connection string. If unset, the app falls back to a local JSON
# file (data/calls.json). CALLS_DB_NAME is the database to use.
CALLS_MONGODB_URI=
CALLS_DB_NAME=vectra

# ---- Call recording (EnableX) ----
# Set to "true" to auto-start recording when a call connects. The recording URL is
# delivered back via the /event webhook and stored with the call. Default: off.
ENABLE_RECORDING=false

# ---- Live transcript webhook (Dialogs Cloud posts the call transcript here) ----
# Shared secret the transcript webhook must present (Bearer token or x-api-key).
# If unset, the /api/transcript endpoint accepts posts without auth (local dev only).
TRANSCRIPT_AUTH_TOKEN=

# ---- Login/logout activity logging (shared activity DB) ----
# If LOG_MONGODB_URI is unset, activity logging is a safe no-op.
# LOG_DB_NAME is REQUIRED (otherwise the default 'portal_db' overrides the DB in the URI).
LOG_MONGODB_URI=mongodb://user:pass@host1:27017,host2:27017,host3:27017/vcxdemosdb?replicaSet=vcxmongodbrs&readPreference=nearest
LOG_DB_NAME=vcxdemosdb

# ---- Second dial number (its own EnableX project + portal voice agent) ----
# Shown in the "Dial Number" dropdown. The agent bound to this number in the
# EnableX portal drives the conversation, so only its credentials are needed.
ENABLEX_FROM_NUMBER_ALT=
ENABLEX_APP_ID_ALT=
ENABLEX_APP_KEY_ALT=
# ENABLEX_BASE_URL_ALT=https://api.enablex.io
